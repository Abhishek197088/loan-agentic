# LLM Provider Configuration
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./loan_underwriting.db

# Underwriting Policy Configuration
MAX_FOIR_PERCENT=40.0
DEFAULT_ANNUAL_INTEREST_RATE=12.0
MAX_ALLOWED_TENURE_MONTHS=84
MIN_ALLOWED_TENURE_MONTHS=6
MAX_LOAN_AMOUNT=10000000
MIN_LOAN_AMOUNT=10000
ALLOW_COUNTER_OFFER_TENURE_EXTENSION=true

# Security Settings
MAX_UPLOAD_SIZE_MB=5
ALLOWED_EXTENSIONS=pdf
ENABLE_STRICT_PROMPT_INJECTION_DEFENSE=true
